{
  "name": "dedup-log",
  "version": "0.9.0",
  "description": "Lazy logger that rotates per day and deduplicates closed logs into Lino .log.lino files",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./server": {
      "types": "./src/server.d.ts",
      "import": "./src/server.js"
    }
  },
  "bin": {
    "dedup-log": "bin/dedup-log.js"
  },
  "files": [
    "src/",
    "bin/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test --test-timeout=30000 tests/*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:duplication": "jscpd .",
    "check": "npm run lint && npm run format:check && npm run check:duplication",
    "prepare": "husky || true",
    "start": "node src/server.js",
    "demo": "node examples/basic-usage.js",
    "changeset": "changeset",
    "changeset:version": "node scripts/changeset-version.mjs",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status --since=origin/main"
  },
  "keywords": [
    "logging",
    "lazy",
    "dedup",
    "deduplication",
    "lino",
    "log-rotation",
    "log-lazy",
    "deduplino"
  ],
  "author": "Link Foundation",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/link-foundation/dedup-log"
  },
  "bugs": {
    "url": "https://github.com/link-foundation/dedup-log/issues"
  },
  "homepage": "https://github.com/link-foundation/dedup-log#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "deduplino": "^0.0.9",
    "log-lazy": "^1.0.4"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jscpd": "^4.0.5",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "test-anywhere": "^0.8.48"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write",
      "prettier --check"
    ],
    "*.md": [
      "prettier --write",
      "prettier --check"
    ]
  }
}
